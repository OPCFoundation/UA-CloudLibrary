; Opts `dotnet test` into the Microsoft.Testing.Platform experience.
; The test projects use xunit.v3, which runs on Microsoft.Testing.Platform; on the
; .NET 10 SDK and later, running them through the legacy VSTest target is no longer
; supported (see https://aka.ms/dotnet-test-mtp-error).
[dotnet.test.runner]
name = "Microsoft.Testing.Platform"
