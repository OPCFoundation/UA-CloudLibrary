
@namespace AdminShell
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UA Cloud Library</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/all.css" />
    <link rel="stylesheet" href="~/css/treeStyles.css" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
        var isHome = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase);
        var isSignedIn = SignInManager.IsSignedIn(User);
        var navItems = isSignedIn
            ? new (string Controller, string Label, string Icon)[]
            {
                ("Home", "Home", "fa-home"),
                ("Explorer", "Explorer", "fa-cubes"),
                ("Upload", "Upload", "fa-cloud-upload-alt"),
            }
            : new (string Controller, string Label, string Icon)[]
            {
                ("Home", "Home", "fa-home"),
            };
    }
    <header class="app-bar">
        <nav class="navbar navbar-expand-md navbar-dark app-bar-toolbar">
            <div class="container-fluid">
                <a class="navbar-brand app-bar-brand" asp-area="" asp-controller="Home" asp-action="Index" title="Home">
                    <img class="app-bar-logo" src="~/opclogo-white.png" alt="OPC Foundation" />
                    <span class="app-bar-title">UA Cloud Library</span>
                </a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#appBarNav" aria-controls="appBarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="appBarNav">
                    <div class="app-bar-nav-wrap @(isHome ? "d-none" : null)">
                        <ul class="navbar-nav app-bar-nav">
                            @foreach (var item in navItems)
                            {
                                var active = string.Equals(currentController, item.Controller, StringComparison.OrdinalIgnoreCase);
                                <li class="nav-item">
                                    <a class="nav-link app-bar-nav-link @(active ? "active" : null)" asp-area="" asp-controller="@item.Controller" asp-action="Index" aria-current="@(active ? "page" : null)">
                                        <i class="fas @item.Icon mr-2" aria-hidden="true"></i>@item.Label
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="app-bar-actions ml-md-auto">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pt-2 pb-3 mb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer">
        <div class="container-fluid d-flex flex-wrap justify-content-between align-items-center">
            <div class="footer-links">
                <a href="https://opcfoundation.org/imprint/" target="_blank" rel="noopener noreferrer">&copy; @DateTime.UtcNow.Year OPC Federation AISBL</a>
                <a href="https://opcfoundation.org/about/contact-us/" target="_blank" rel="noopener noreferrer">Contact Us</a>
                <a href="https://opcfoundation.org/membership/become-a-member/step1" target="_blank" rel="noopener noreferrer">Become a Member</a>
                <a href="https://opcfoundation.org/privacy-policy/" target="_blank" rel="noopener noreferrer">Privacy Policy</a>
                <a href="https://opcfoundation.org/license/services/1.0/" target="_blank" rel="noopener noreferrer">Terms of Use</a>
            </div>
            <div class="footer-version">
                <a href="https://github.com/OPCFoundation/UA-CloudLibrary/tree/@ThisAssembly.GitCommitId" target="_blank" rel="noopener noreferrer" title="Commit @ThisAssembly.GitCommitId, committed @(ThisAssembly.GitCommitDate.ToString("yyyy-MM-dd HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)) UTC">@ThisAssembly.AssemblyInformationalVersion &middot; @(ThisAssembly.GitCommitDate.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))</a>
            </div>
        </div>
    </footer>
    <script src="_framework/blazor.server.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        async function downloadFileFromBase64(filename, base64Data) {
            // Decode base64 via fetch data-URL (efficient native decoding, no char-by-char loop)
            const response = await fetch(`data:application/zip;base64,${base64Data}`);
            const blob = await response.blob();

            // Create download link
            const url = window.URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = url;
            link.download = filename;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            window.URL.revokeObjectURL(url);
        }

        async function downloadFileFromStream(filename, contentStreamReference) {
            const arrayBuffer = await contentStreamReference.arrayBuffer();
            const blob = new Blob([arrayBuffer], { type: 'application/zip' });
            const url = URL.createObjectURL(blob);
            const anchorElement = document.createElement('a');

            anchorElement.href = url;
            anchorElement.download = filename;
            anchorElement.click();
            anchorElement.remove();

            URL.revokeObjectURL(url);
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
