<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Opc.Ua.Cloud.Library</RootNamespace>
		<UserSecretsId>ee5a630a-263e-4334-b590-b77013c2af56</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerfileContext>./..</DockerfileContext>
		<DockerComposeProjectPath>..\docker-compose.dcproj</DockerComposeProjectPath>
		<DefineConstants>$(DEFINECONSTANTS)</DefineConstants>
    <WarningsAsErrors>CS0618;CS0612;CS0672</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Application.Config.xml" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Application.Config.xml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="Migrations\Scripts\*.sql" />
	</ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="CloudLibClient.Tests" />
        <InternalsVisibleTo Include="UACloudLibraryServer.UnitTests" />
    </ItemGroup>
	<PropertyGroup Condition=" '$(RunConfiguration)' == 'UA_CloudLibrary' " />

	<ItemGroup>
		<None Include="..\.editorconfig" Link=".editorconfig" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="LinqKit.Microsoft.EntityFrameworkCore" Version="10.1.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Proxies" Version="10.0.13" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.1" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
		<PackageReference Include="OPCFoundation.NetStandard.Opc.Ua" Version="2.0.1" />
		<PackageReference Include="OPCFoundation.NetStandard.Opc.Ua.Client.ComplexTypes" Version="2.0.1" />
		<PackageReference Include="Postmark" Version="5.4.1" />
		<PackageReference Include="SendGrid" Version="9.29.3" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
		<PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.3.1" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.402" />
    <PackageReference Update="Nerdbank.GitVersioning" Version="3.10.94" />
	</ItemGroup>
</Project>
