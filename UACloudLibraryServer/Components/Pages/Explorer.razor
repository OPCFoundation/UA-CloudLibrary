@using System.Net
@using System.Net.Http
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@using System.Web
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web;
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using Opc.Ua.Cloud.Library.Models
@using System.Security.Claims

@inject IJSRuntime JS
@inject CloudLibDataProvider DataProvider
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

@if (Loading)
{
    <div class="uacl-loading-overlay">
        <div class="uacl-loading-content">
            <div class="spinner-border text-primary" role="status" style="width:3rem;height:3rem;">
                <span class="visually-hidden">Searching...</span>
            </div>
            <p class="mt-3 text-white fw-semibold">Searching...</p>
        </div>
    </div>
}
<div style="height:100%">
    <div class="uacl-container">
        <div class="uacl-content">
            <div class="container">
                <div class="input-group mb-3">
                    <div class="input-group-prepend">
                        <span class="input-group-text" id="inputGroup-sizing-default">Search</span>
                        <button type="button" class="btn btn-outline-secondary" title="Search help" aria-label="Search help" @onclick="@(() => ShowSearchHelp = true)">
                            <strong>?</strong>
                        </button>
                    </div>
                    <input type="text" class="form-control" aria-label="Default" aria-describedby="inputGroup-sizing-default" value="@string.Join(",", SearchKeywords)" @onchange="@OnSearchTextChanged">
                    <div class="input-group-append">
                        <span class="input-group-text">Items per page</span>
                        <input type="number" min="2" max="99" class="form-control" style="max-width: 4.5rem; flex: 0 0 auto;" aria-label="Items per page" value="@PAGE_SIZE" @onchange="@OnPageSizeChanged">
                    </div>
                </div>

                @if (ShowSearchHelp)
                {
                    <div class="modal-backdrop fade show" @onclick="@(() => ShowSearchHelp = false)"></div>
                }
                <div class="modal fade @(ShowSearchHelp ? "show" : string.Empty)" id="searchHelpModal" tabindex="-1" aria-labelledby="searchHelpModalLabel" aria-hidden="@(ShowSearchHelp ? "false" : "true")" style="display: @(ShowSearchHelp ? "block" : "none");" role="dialog">
                    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="searchHelpModalLabel">Search options</h5>
                                <button type="button" class="btn-close" aria-label="Close" @onclick="@(() => ShowSearchHelp = false)">&times;</button>
                            </div>
                            <div class="modal-body">
                                <p>
                                    Enter one or more keywords separated by commas. Prefix a keyword with one of the
                                    filters below to narrow the search. Filters and plain keywords can be combined.
                                </p>
                                <table class="table table-sm table-striped">
                                    <thead>
                                        <tr>
                                            <th style="width: 130px;">Filter</th>
                                            <th>Description</th>
                                            <th style="width: 220px;">Example</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td><code>name:</code></td>
                                            <td>Matches the nodeset <em>Title</em> (case-insensitive substring / regex).</td>
                                            <td><code>name:robotics</code></td>
                                        </tr>
                                        <tr>
                                            <td><code>publisher:</code></td>
                                            <td>Matches the publisher / user that owns the nodeset.</td>
                                            <td><code>publisher:opc</code></td>
                                        </tr>
                                        <tr>
                                            <td><code>type:</code></td>
                                            <td>
                                                Matches the <em>BrowseName</em> of a contained ObjectType, InterfaceType,
                                                VariableType, DataType or ReferenceType.
                                            </td>
                                            <td><code>type:MotorType</code></td>
                                        </tr>
                                        <tr>
                                            <td><code>license:</code></td>
                                            <td>Matches the license expression of the nodeset (e.g. MIT, Apache-2.0).</td>
                                            <td><code>license:MIT</code></td>
                                        </tr>
                                        <tr>
                                            <td><code>exact:</code></td>
                                            <td>Matches the <em>ModelUri</em> of the nodeset.</td>
                                            <td><code>exact:http://opcfoundation.org/UA/DI/</code></td>
                                        </tr>
                                        <tr>
                                            <td><code>date:</code></td>
                                            <td>
                                                Only include nodesets whose <em>PublicationDate</em> is on or after the given date.
                                                Accepted formats: <code>yyyy</code> or <code>yyyy-MM</code>. When multiple
                                                <code>date:</code> values are supplied the latest one is used.
                                            </td>
                                            <td><code>date:2023-01</code></td>
                                        </tr>
                                        <tr>
                                            <td><code>sort:</code></td>
                                            <td>
                                                Sorts the results. Supported values: <code>date</code> (newest first),
                                                <code>publisher</code> (A-Z), <code>downloads</code> (most downloaded first).
                                            </td>
                                            <td><code>sort:downloads</code></td>
                                        </tr>
                                        <tr>
                                            <td><em>(no prefix)</em></td>
                                            <td>
                                                Plain keyword: matches against <em>Title</em>, <em>Description</em>,
                                                <em>ModelUri</em> and <em>Keywords</em> of the nodeset.
                                            </td>
                                            <td><code>temperature</code></td>
                                        </tr>
                                    </tbody>
                                </table>
                                <p class="mb-0">
                                    <strong>Tip:</strong> Combine filters with commas, for example
                                    <code>name:robot, license:MIT, date:2022, sort:downloads</code>.
                                </p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" @onclick="@(() => ShowSearchHelp = false)">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="uacl-result-wrapper">
                    <table class="table align-middle uacl-result-table">
                        <thead>
                            <tr>
                                <th>Nodeset</th>
                                <th>License</th>
                                <th>Published</th>
                                <th class="text-end">Downloads</th>
                                <th class="text-center" style="width: 150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Result)
                            {
                                var rowItem = item;
                                var isSelected = SelectedItem != null && ReferenceEquals(SelectedItem, rowItem);
                                <tr class="uacl-result-row @(isSelected ? "is-selected" : null)" @onclick="() => SelectItem(rowItem)">
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrWhiteSpace(rowItem.IconUrl))
                                            {
                                                <img src="@rowItem.IconUrl" alt="" class="uacl-row-icon mr-3" />
                                            }
                                            else
                                            {
                                                <div class="uacl-row-icon uacl-row-icon-placeholder mr-3">
                                                    <i class="fas fa-cube"></i>
                                                </div>
                                            }
                                            <div class="min-w-0">
                                                <div class="fw-semibold text-truncate">@rowItem.Title</div>
                                                <small class="text-muted text-truncate d-block">@rowItem.NodeSet?.ModelUri</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-nowrap">
                                        @if (string.IsNullOrWhiteSpace(rowItem.License))
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill uacl-badge-license">@rowItem.License
                                            <small class="text-muted ml-1">v@(string.IsNullOrWhiteSpace(rowItem.NodeSet?.Version) ? "-" : rowItem.NodeSet.Version)</small>
                                            </span>
                                        }
                                    </td>
                                    <td class="text-nowrap">@rowItem.NodeSet?.PublicationDate?.ToString("yyyy-MM-dd")</td>
                                    <td class="text-end fw-semibold">@rowItem.NumberOfDownloads</td>
                                    <td class="text-center text-nowrap" @onclick:stopPropagation="true">
                                        <button type="button" class="btn btn-sm uacl-icon-btn" title="View" aria-label="View" @onclick="() => ViewFileFromURL(rowItem)">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm uacl-icon-btn" title="Download" aria-label="Download" @onclick="() => DownloadFileFromURL(rowItem)">
                                            <i class="fas fa-download"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm uacl-icon-btn" title="More" aria-label="More" @onclick="() => Open(rowItem)">
                                            <i class="fas fa-ellipsis-h"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (SelectedItem != null)
                {
                    <div class="uacl-details card shadow-sm mt-3 mb-3">
                        <div class="card-header d-flex align-items-center justify-content-between bg-light">
                            <div class="d-flex align-items-center">
                                @if (!string.IsNullOrWhiteSpace(SelectedItem.IconUrl))
                                {
                                    <img src="@SelectedItem.IconUrl" alt="" class="uacl-details-icon mr-3" />
                                }
                                else
                                {
                                    <div class="uacl-details-icon-placeholder mr-3">
                                        <i class="fas fa-cube"></i>
                                    </div>
                                }
                                <div>
                                    <h5 class="mb-0">@SelectedItem.Title</h5>
                                    <small class="text-muted">@SelectedItem.NodeSet?.ModelUri</small>
                                </div>
                            </div>
                            <button type="button" class="btn-close" aria-label="Close details" @onclick="() => SelectedItem = null"></button>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <h6 class="text-uppercase text-muted small">Description</h6>
                                    <p class="mb-3">@(string.IsNullOrWhiteSpace(SelectedItem.Description) ? "No description available." : SelectedItem.Description)</p>

                                    @if (!string.IsNullOrWhiteSpace(SelectedItem.CopyrightText))
                                    {
                                        <h6 class="text-uppercase text-muted small">Copyright</h6>
                                        <p class="mb-3">@SelectedItem.CopyrightText</p>
                                    }

                                    @if (SelectedItem.Keywords != null && SelectedItem.Keywords.Length > 0)
                                    {
                                        <h6 class="text-uppercase text-muted small">Keywords</h6>
                                        <div class="mb-3">
                                            @foreach (var kw in SelectedItem.Keywords)
                                            {
                                                <span class="uacl-chip mr-1 mb-1">@kw</span>
                                            }
                                        </div>
                                    }

                                    @if (SelectedItem.SupportedLocales != null && SelectedItem.SupportedLocales.Length > 0)
                                    {
                                        <h6 class="text-uppercase text-muted small">Supported locales</h6>
                                        <div class="mb-3">
                                            @foreach (var loc in SelectedItem.SupportedLocales)
                                            {
                                                <span class="uacl-chip uacl-chip-info mr-1 mb-1">@loc</span>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="col-md-4">
                                    <dl class="row small mb-0">
                                        <dt class="col-5 text-muted">Owner</dt>
                                        <dd class="col-7">@(string.IsNullOrEmpty(SelectedItem.UserId) ? "Administrator" : SelectedItem.UserId)</dd>

                                        <dt class="col-5 text-muted">License</dt>
                                        <dd class="col-7">@(string.IsNullOrWhiteSpace(SelectedItem.License) ? "-" : SelectedItem.License)</dd>

                                        <dt class="col-5 text-muted">Version</dt>
                                        <dd class="col-7">@(string.IsNullOrWhiteSpace(SelectedItem.NodeSet?.Version) ? "-" : SelectedItem.NodeSet.Version)</dd>

                                        <dt class="col-5 text-muted">Published</dt>
                                        <dd class="col-7">@SelectedItem.NodeSet?.PublicationDate?.ToString("yyyy-MM-dd")</dd>

                                        <dt class="col-5 text-muted">Last modified</dt>
                                        <dd class="col-7">@SelectedItem.NodeSet?.LastModifiedDate?.ToString("yyyy-MM-dd")</dd>

                                        <dt class="col-5 text-muted">Downloads</dt>
                                        <dd class="col-7">@SelectedItem.NumberOfDownloads</dd>

                                        <dt class="col-5 text-muted">Nodeset ID</dt>
                                        <dd class="col-7 text-break">@SelectedItem.NodesetId</dd>

                                        <dt class="col-5 text-muted">Created</dt>
                                        <dd class="col-7">@SelectedItem.CreationTime.ToString("yyyy-MM-dd")</dd>
                                    </dl>
                                </div>
                            </div>

                            @{
                                var links = new (string Label, string Url, string Icon)[]
                                {
                                    ("Documentation", SelectedItem.DocumentationUrl, "fa-book"),
                                    ("License", SelectedItem.LicenseUrl, "fa-file-contract"),
                                    ("Release notes", SelectedItem.ReleaseNotesUrl, "fa-clipboard-list"),
                                    ("Test specification", SelectedItem.TestSpecificationUrl, "fa-vial"),
                                    ("Purchasing information", SelectedItem.PurchasingInformationUrl, "fa-shopping-cart"),
                                };
                                var visibleLinks = links.Where(l => !string.IsNullOrWhiteSpace(l.Url)).ToArray();

                                string referenceSearchUrl = null;
                                var typeTerm = SearchKeywords?
                                    .Where(k => !string.IsNullOrWhiteSpace(k) && k.StartsWith("type:", StringComparison.OrdinalIgnoreCase))
                                    .Select(k => k.Substring("type:".Length).Trim())
                                    .FirstOrDefault(t => !string.IsNullOrWhiteSpace(t));
                                if (!string.IsNullOrWhiteSpace(typeTerm)
                                    && !string.IsNullOrWhiteSpace(SelectedItem.DocumentationUrl)
                                    && SelectedItem.DocumentationUrl.StartsWith("https://reference.opcfoundation.org/", StringComparison.OrdinalIgnoreCase))
                                {
                                    referenceSearchUrl = $"https://reference.opcfoundation.org/search?q={Uri.EscapeDataString(typeTerm)}&tab=node";
                                }
                            }
                            @if (visibleLinks.Length > 0 || referenceSearchUrl != null)
                            {
                                <hr />
                                <h6 class="text-uppercase text-muted small">Links</h6>
                                <div class="d-flex flex-wrap uacl-link-list">
                                    @foreach (var link in visibleLinks)
                                    {
                                        <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-secondary mr-2 mb-2">
                                            <i class="fas @link.Icon mr-2"></i>@link.Label
                                        </a>
                                    }
                                    @if (referenceSearchUrl != null)
                                    {
                                        <a href="@referenceSearchUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary mr-2 mb-2" title="Search this type on reference.opcfoundation.org">
                                            <i class="fas fa-external-link-alt mr-2"></i>Reference: @typeTerm
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                        <div class="card-footer bg-white d-flex justify-content-end">
                            <button type="button" class="btn btn-outline-primary mr-2" @onclick="() => ViewFileFromURL(SelectedItem)">
                                <i class="fas fa-eye mr-2"></i>View
                            </button>
                            <button type="button" class="btn btn-primary" @onclick="() => DownloadFileFromURL(SelectedItem)">
                                <i class="fas fa-download mr-2"></i>Download
                            </button>
                        </div>
                    </div>
                }
            </div>
        <div class="uacl-pagination pt-2">
            <nav aria-label="Page navigation example">
                <ul class="pagination justify-content-center">
                    @if (FirstItemOnPage > 0)
                    {
                        <li class="page-item"><a class="page-link" @onclick="() => ChangePage(-1)">Previous</a></li>
                        @if (CurrentPage != 1)
                        {
                            <li class="page-item"><a class="page-link" @onclick="() => ChangePageAbsolute(1)">1</a></li>
                        }
                        @if (CurrentPage - 4 == 3)
                        {
                            <li class="page-item"><a class="page-link" @onclick="() => ChangePageAbsolute(CurrentPage - 4)">2</a></li>
                        }
                        @if (CurrentPage - 4 > 3)
                        {
                            <li class="page-item"><a class="page-link" @onclick="() => ChangePageAbsolute(CurrentPage - 4)">...</a></li>
                        }
                        @for (int i = Math.Max(2, CurrentPage - 4); i < CurrentPage; i++)
                        {
                            int j = i;
                            <li class="page-item"><a class="page-link" @onclick="() => ChangePageAbsolute(j)">@i</a></li>
                        }

                        <li class="page-item active"><a class="page-link">@CurrentPage of @AllPages</a></li>

                        @for (int i = CurrentPage + 1; i <= Math.Min(AllPages - 1, CurrentPage + 4); i++)
                        {
                            int j = i;
                            <li class="page-item"><a class="page-link" @onclick="() => ChangePageAbsolute(j)">@i</a></li>
                        }
                        @if (CurrentPage + 4 == AllPages - 2)
                        {
                            <li class="page-item"><a class="page-link" @onclick="() => ChangePageAbsolute(CurrentPage + 4)">@(CurrentPage + 5)</a></li>
                        }
                        @if (CurrentPage + 4 < AllPages - 2)
                        {
                            <li class="page-item"><a class="page-link" @onclick="() => ChangePageAbsolute(CurrentPage + 4)">...</a></li>
                        }

                        @if (CurrentPage != AllPages)
                        {
                            <li class="page-item"><a class="page-link" @onclick="() => ChangePageAbsolute(AllPages)">@AllPages</a></li>
                        }
                        <li class="page-item"><a class="page-link" @onclick="() => ChangePage(+1)">Next</a></li>
                    }
                    else
                    {
                        <li class="page-item">No nodesets matching search keywords @string.Join(" ", SearchKeywords?.Select(k => $"'{k}'")).</li>
                    }
                </ul>
                <ul class="pagination justify-content-center">
                    <li class="page-item">Nodeset count: @TotalCount</li>
                </ul>
            </nav>
        </div>
    </div>
    </div>
</div>

<div class="modal @ModalClass" tabindex="-1" role="dialog" style="@ModalDisplay">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@ModalTitle</h5>
            </div>
            <div class="modal-body">
                <p>@ModalDescription</p>
            </div>
            <div class="modal-body">
                <a href="@ModalDocumentationUrl" target="_blank" rel="noopener noreferrer">@ModalDocumentationUrl</a>
            </div>
            <div class="modal-footer">
                @if (IsOwnedByCurrentUser(CurrentItem))
                {
                    <button type="button" class="btn btn-outline-danger mr-auto" @onclick="() => OpenDeleteConfirmation(CurrentItem)">
                        <i class="fas fa-trash-alt mr-2"></i>Delete
                    </button>
                }
                <button class="btn btn-primary" style="margin-right: 1rem;" @onclick="() => DownloadFileFromURL(CurrentItem)">Download</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal" @onclick="() => Close()">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal @(ShowDeleteConfirmation ? "show" : string.Empty)" tabindex="-1" role="dialog" aria-hidden="@(ShowDeleteConfirmation ? "false" : "true")" style="display: @(ShowDeleteConfirmation ? "block" : "none");">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete nodeset</h5>
                <button type="button" class="btn-close" aria-label="Close" @onclick="CloseDeleteConfirmation" disabled="@Deleting">&times;</button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to permanently delete the nodeset <strong>@ItemToDelete?.Title</strong> (@ItemToDelete?.NodeSet?.ModelUri)?</p>
                <p class="mb-0 text-danger">This action cannot be undone.</p>
                @if (!string.IsNullOrEmpty(DeleteError))
                {
                    <div class="alert alert-danger mt-3 mb-0" role="alert">@DeleteError</div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseDeleteConfirmation" disabled="@Deleting">Cancel</button>
                <button type="button" class="btn btn-danger" @onclick="ConfirmDelete" disabled="@Deleting">
                    @if (Deleting)
                    {
                        <span class="spinner-border spinner-border-sm mr-2" role="status" aria-hidden="true"></span>
                    }
                    Delete
                </button>
            </div>
        </div>
    </div>
</div>

@if (ShowBackDrop || ShowDeleteConfirmation)
{
    <div class="modal-backdrop fade show"></div>
}

@code
{
    private async Task OnSearchTextChanged(Microsoft.AspNetCore.Components.ChangeEventArgs patharg)
    {
        var searchText = patharg.Value?.ToString();
        var keywords = searchText?.Split(",").Select(k => k.Trim()).ToArray();
        keywords = keywords != null && keywords.Length > 0 && !string.IsNullOrEmpty(keywords[0]) ? keywords : new[] { "*" };

        if (!SearchKeywords.SequenceEqual(keywords))
        {
            SearchKeywords = keywords;
            CurrentPage = 1;

            UpdateUrl();
            await FetchData();
        }
    }
    private async Task OnPageSizeChanged(Microsoft.AspNetCore.Components.ChangeEventArgs patharg)
    {
        if (int.TryParse(patharg.Value?.ToString(), out var pageSize) && pageSize > 1 && pageSize <= 100)
        {
            PAGE_SIZE = pageSize;
            CurrentPage = 1;

            UpdateUrl();
            await FetchData();
        }
    }

    private string ModalClass = "";
    private string ModalDisplay = "display:none";
    private bool ShowBackDrop = false;

    private NamespaceMetaDataModel CurrentItem;

    private NamespaceMetaDataModel SelectedItem;

    private void SelectItem(NamespaceMetaDataModel item)
    {
        SelectedItem = ReferenceEquals(SelectedItem, item) ? null : item;
    }

    private string ModalTitle = "";
    private string ModalDescription = "";
    private string ModalDocumentationUrl = "";


    int PAGE_SIZE = 6;
    const int COL_SIZE = 3;
    public bool Loading { get; set; } = true;
    private List<NamespaceMetaDataModel> Result = new();
    private int CurrentPage = 1;
    private int FirstItemOnPage = 0;
    private int LastItemOnPage = 0;
    private int TotalCount = 0;
    private int AllPages = 0;

    private string[] SearchKeywords { get; set; } = new[] { "" };

    private bool ShowSearchHelp { get; set; }

    private ClaimsPrincipal UserId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync().ConfigureAwait(false);

        UserId = state.User;

        RestoreStateFromUrl();

        await FetchData().ConfigureAwait(false);
    }

    private void RestoreStateFromUrl()
    {
        var uri = new Uri(NavigationManager.Uri);
        var qs = System.Web.HttpUtility.ParseQueryString(uri.Query);

        var q = qs["q"];
        if (!string.IsNullOrWhiteSpace(q))
        {
            var keywords = q.Split(',').Select(k => k.Trim()).Where(k => !string.IsNullOrEmpty(k)).ToArray();
            if (keywords.Length > 0)
            {
                SearchKeywords = keywords;
            }
        }

        if (int.TryParse(qs["page"], out var page) && page > 0)
        {
            CurrentPage = page;
        }

        if (int.TryParse(qs["size"], out var size) && size > 1 && size <= 100)
        {
            PAGE_SIZE = size;
        }
    }

    private void UpdateUrl()
    {
        var parts = new List<string>();

        var kw = SearchKeywords != null ? string.Join(",", SearchKeywords.Where(k => !string.IsNullOrWhiteSpace(k) && k != "*")) : string.Empty;
        if (!string.IsNullOrWhiteSpace(kw))
        {
            parts.Add($"q={Uri.EscapeDataString(kw)}");
        }
        if (CurrentPage > 1)
        {
            parts.Add($"page={CurrentPage}");
        }
        if (PAGE_SIZE != 6)
        {
            parts.Add($"size={PAGE_SIZE}");
        }

        var uri = new Uri(NavigationManager.Uri);
        var newUrl = uri.GetLeftPart(UriPartial.Path) + (parts.Count > 0 ? "?" + string.Join("&", parts) : string.Empty);

        if (!string.Equals(newUrl, NavigationManager.Uri, StringComparison.Ordinal))
        {
            NavigationManager.NavigateTo(newUrl, forceLoad: false, replace: true);
        }
    }

    private async Task DownloadFileFromURL(NamespaceMetaDataModel item)
    {
        var fileName = $"{item.Title}.NodeSet2.xml";
        var fileURL = $@"/infomodel/download/{item.NodeSet.Identifier}?nodesetXMLOnly=true";
        await JS.InvokeVoidAsync("triggerFileDownload", fileName, fileURL).ConfigureAwait(false);
    }

    private void ViewFileFromURL(NamespaceMetaDataModel item)
    {
        var typeTerm = SearchKeywords?
            .Where(k => !string.IsNullOrWhiteSpace(k) && k.StartsWith("type:", StringComparison.OrdinalIgnoreCase))
            .Select(k => k.Substring("type:".Length).Trim())
            .FirstOrDefault(t => !string.IsNullOrWhiteSpace(t));

        var url = $"/browser?NodesetIdentifier={item.NodeSet.Identifier}&NodesetName={Uri.EscapeDataString(item.Title ?? string.Empty)}&UserName={UserId.Identity.Name}";
        if (!string.IsNullOrWhiteSpace(typeTerm))
        {
            url += $"&search={Uri.EscapeDataString("type:" + typeTerm)}";
        }

        NavigationManager.NavigateTo(url, true);
    }

    private void Open(NamespaceMetaDataModel item)
    {
        ModalDisplay = "display:block;";
        ModalClass = "Show";
        ShowBackDrop = true;
        ModalTitle = item.Title;
        ModalDescription = item.Description;
        ModalDocumentationUrl = item.DocumentationUrl;
        CurrentItem = item;

        StateHasChanged();
    }

    private void Close()
    {
        ModalDisplay = "display:none";
        ModalClass = "";
        ShowBackDrop = false;

        StateHasChanged();
    }

    private bool ShowDeleteConfirmation;
    private bool Deleting;
    private string DeleteError;
    private NamespaceMetaDataModel ItemToDelete;

    private bool IsOwnedByCurrentUser(NamespaceMetaDataModel item)
    {
        var userName = UserId?.Identity?.Name;
        return item != null
            && !string.IsNullOrEmpty(userName)
            && !string.IsNullOrEmpty(item.UserId)
            && string.Equals(item.UserId, userName, StringComparison.Ordinal);
    }

    private void OpenDeleteConfirmation(NamespaceMetaDataModel item)
    {
        if (!IsOwnedByCurrentUser(item))
        {
            return;
        }

        Close();

        ItemToDelete = item;
        DeleteError = null;
        ShowDeleteConfirmation = true;
    }

    private void CloseDeleteConfirmation()
    {
        if (Deleting)
        {
            return;
        }

        ShowDeleteConfirmation = false;
        ItemToDelete = null;
        DeleteError = null;
    }

    private async Task ConfirmDelete()
    {
        if (ItemToDelete == null || !IsOwnedByCurrentUser(ItemToDelete))
        {
            CloseDeleteConfirmation();
            return;
        }

        if (!uint.TryParse(ItemToDelete.NodesetId, out var nodesetId))
        {
            DeleteError = "The nodeset identifier could not be parsed.";
            return;
        }

        Deleting = true;
        DeleteError = null;

        try
        {
            var deleted = await DataProvider.DeleteNodeSetOwnedByUserAsync(UserId.Identity.Name, nodesetId);
            if (!deleted)
            {
                DeleteError = "The nodeset could not be deleted. It may no longer exist or you are not its owner.";
                return;
            }

            if (ReferenceEquals(SelectedItem, ItemToDelete))
            {
                SelectedItem = null;
            }
            if (ReferenceEquals(CurrentItem, ItemToDelete))
            {
                CurrentItem = null;
            }

            Deleting = false;
            CloseDeleteConfirmation();

            if (Result.Count == 1 && CurrentPage > 1)
            {
                CurrentPage--;
                UpdateUrl();
            }

            await FetchData();
        }
        catch (Exception ex)
        {
            DeleteError = $"Failed to delete the nodeset: {ex.Message}";
        }
        finally
        {
            Deleting = false;
        }
    }

    private async Task ChangePageAbsolute(int requestedPage)
    {
        var newPage = (this.TotalCount > 0) ? Math.Clamp(requestedPage, 1, (int)Math.Ceiling((decimal)this.TotalCount / PAGE_SIZE)) : 0;
        if (!CurrentPage.Equals(newPage))
        {
            CurrentPage = newPage;

            UpdateUrl();
            await FetchData();
        }
    }

    private async Task ChangePage(int increment)
    {
        await ChangePageAbsolute(this.CurrentPage + increment);
    }

    private async Task FetchData()
    {
await InvokeAsync(async () =>
{
    Loading = true;
    StateHasChanged();
    await Task.Yield(); // allow Blazor to flush the render and show the overlay before DB work starts
});
        IQueryable<NamespaceMetaDataModel> nodesetQuery = DataProvider.GetNodeSets(UserId.Identity.Name, keywords: SearchKeywords).Select(n => n.Metadata);
        bool hasSortKeyword = SearchKeywords != null && SearchKeywords.Any(k => k.StartsWith("sort:", StringComparison.OrdinalIgnoreCase));
        IQueryable<NamespaceMetaDataModel> allOrderedNodesets = hasSortKeyword ? nodesetQuery : nodesetQuery.OrderBy(md => md.Title);

        TotalCount = await allOrderedNodesets.CountAsync();

        int skip = (CurrentPage - 1) * PAGE_SIZE;

        Result = await allOrderedNodesets.Skip((CurrentPage - 1) * PAGE_SIZE).Take(PAGE_SIZE).ToListAsync();

        AllPages = (int)Math.Ceiling((decimal)this.TotalCount / PAGE_SIZE);

        if (Result.Count > 0)
        {
            FirstItemOnPage = skip + 1;
            LastItemOnPage = FirstItemOnPage + Result.Count - 1;
        }
        else
        {
            FirstItemOnPage = 0;
            LastItemOnPage = 0;
            SelectedItem = null;
        }

Loading = false;
await InvokeAsync(StateHasChanged);
    }
}

