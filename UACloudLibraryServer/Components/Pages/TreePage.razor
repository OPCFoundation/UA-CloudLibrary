    // An exported file holds the full node values with the set applied, in the same shape as the
    // owner's saved values. Only entries that differ from the current nodeset value are stored in
    // the set, so importing an export does not override every node with an identical copy.
    private async Task ImportValueSetFile(InputFileChangeEventArgs e)
    {
        if (ActiveValueSet == null || e.File == null)
        {
            return;
        }

        IsImporting = true;
        ValueSetStatus = string.Empty;
        ValueSetImportDetails = new List<string>();
        ShowValueSetImportDetails = false;
        await InvokeAsync(StateHasChanged).ConfigureAwait(false);

        try
        {
            Dictionary<string, JsonElement> parsed;
            using (Stream stream = e.File.OpenReadStream(ValueSetImportMaxBytes))
            {
                parsed = await JsonSerializer.DeserializeAsync<Dictionary<string, JsonElement>>(stream).ConfigureAwait(false);
            }

            if (parsed == null)
            {
                ValueSetStatus = "The file does not contain a JSON object of node values.";
                return;
            }

            List<ushort> indexes = FindUnmappedNamespaceIndexes(parsed);
            if (indexes.Count > 0)
            {
                _pendingImport = parsed;
                _pendingImportFileName = e.File.Name;
                PendingNamespaceIndexes = indexes;
                NamespaceMappings = indexes.ToDictionary(i => i, _ => string.Empty);
                ShowNamespaceMapDialog = true;
                return;
            }

            await ApplyValueSetImportAsync(parsed, e.File.Name, null).ConfigureAwait(false);
        }
        catch (JsonException ex)
        {
            ValueSetStatus = "The file is not valid node values JSON: " + ex.Message;
        }
        catch (IOException ex)
        {
            ValueSetStatus = "The file could not be read: " + ex.Message;
        }
        catch (Exception ex)
        {
            ValueSetStatus = "Import failed: " + ex.Message;
        }
        finally
        {
            IsImporting = false;
            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        }
    }

    // Keys of the form "ns=N;..." carry a server-local namespace index rather than a URI. The tree
    // and the canonical values use "nsu=<uri>;..." ids, so such keys never match a node unless the
    // index is translated. Index 0 is the OPC UA namespace and needs no mapping.
    private static List<ushort> FindUnmappedNamespaceIndexes(Dictionary<string, JsonElement> parsed)
    {
        var indexes = new SortedSet<ushort>();
        foreach (string key in parsed.Keys)
        {
            if (TryGetNamespaceIndex(key, out ushort index, out _) && index != 0)
            {
                indexes.Add(index);
            }
        }

        return indexes.ToList();
    }

    private static bool TryGetNamespaceIndex(string key, out ushort index, out string identifierPart)
    {
        index = 0;
        identifierPart = null;

        if (string.IsNullOrEmpty(key) || !key.StartsWith("ns=", StringComparison.Ordinal))
        {
            return false;
        }

        int separator = key.IndexOf(';');
        if (separator <= 3 || !ushort.TryParse(key.Substring(3, separator - 3), out index))
        {
            return false;
        }

        identifierPart = key.Substring(separator + 1);
        return true;
    }

    private async Task ConfirmNamespaceMapping()
    {
        if (_pendingImport == null)
        {
            ShowNamespaceMapDialog = false;
            return;
        }

        IsImporting = true;
        await InvokeAsync(StateHasChanged).ConfigureAwait(false);

        try
        {
            Dictionary<string, JsonElement> parsed = _pendingImport;
            string fileName = _pendingImportFileName;
            var mapping = NamespaceMappings.Where(kv => !string.IsNullOrEmpty(kv.Value)).ToDictionary(kv => kv.Key, kv => kv.Value);

            ShowNamespaceMapDialog = false;
            _pendingImport = null;
            _pendingImportFileName = string.Empty;

            await ApplyValueSetImportAsync(parsed, fileName, mapping).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            ValueSetStatus = "Import failed: " + ex.Message;
        }
        finally
        {
            IsImporting = false;
            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        }
    }

    private void CancelNamespaceMapping()
    {
        ShowNamespaceMapDialog = false;
        _pendingImport = null;
        _pendingImportFileName = string.Empty;
        PendingNamespaceIndexes = new List<ushort>();
        NamespaceMappings = new Dictionary<ushort, string>();
        ValueSetStatus = "Import cancelled.";
    }

    private async Task ApplyValueSetImportAsync(Dictionary<string, JsonElement> parsed, string fileName, Dictionary<ushort, string> namespaceMapping)
    {
        if (ActiveValueSet == null)
        {
            return;
        }

        Dictionary<string, string> canonical = await _client.BrowseVariableNodesResursivelyAsync(UserName, NodesetIdentifier, null).ConfigureAwait(false)
            ?? new Dictionary<string, string>();

        var toImport = new Dictionary<string, string>(StringComparer.Ordinal);
        var skippedDetails = new List<string>();
        int skipped = 0;
        int unmapped = 0;
        int unknown = 0;
        int unchanged = 0;
        foreach (KeyValuePair<string, JsonElement> kv in parsed)
        {
            // The reserved controlledElements map and anything else that is not a scalar node
            // value belongs to the nodeset's access policy, not to a value set.
            if (string.Equals(kv.Key, DppControlledElements.PropertyName, StringComparison.Ordinal)
                || kv.Value.ValueKind == JsonValueKind.Object
                || kv.Value.ValueKind == JsonValueKind.Array
                || kv.Value.ValueKind == JsonValueKind.Null)
            {
                skipped++;
                continue;
            }

            string key = kv.Key;
            if (TryGetNamespaceIndex(key, out ushort index, out string identifierPart) && index != 0)
            {
                if (namespaceMapping == null || !namespaceMapping.TryGetValue(index, out string namespaceUri))
                {
                    unmapped++;
                    skippedDetails.Add($"{kv.Key}: namespace index {index} was not mapped to a nodeset");
                    continue;
                }

                key = "nsu=" + namespaceUri + ";" + identifierPart;
            }

            // The canonical list only holds variables that currently have a non-empty value, so a
            // valid Variable with an empty value (or one not reached by the hierarchical browse) is
            // missing from it. Verify such ids directly against the server before rejecting them.
            string value = kv.Value.ValueKind == JsonValueKind.String ? kv.Value.GetString() : kv.Value.GetRawText();
            if (!canonical.TryGetValue(key, out string current))
            {
                string reason = await _client.ExplainUnmatchedNodeId(UserName, NodesetIdentifier, key).ConfigureAwait(false);
                if (reason != null)
                {
                    unknown++;
                    skippedDetails.Add(key == kv.Key ? $"{kv.Key}: {reason}" : $"{kv.Key} (mapped to {key}): {reason}");
                    continue;
                }

                toImport[key] = value;
                continue;
            }

            if (!string.Equals(current, value, StringComparison.Ordinal))
            {
                toImport[key] = value;
            }
            else
            {
                unchanged++;
            }
        }

        if (toImport.Count > 0)
        {
            await ValueSetStore.SetValuesAsync(ActiveValueSet.Id, _valueSetUserId, toImport).ConfigureAwait(false);
            foreach (KeyValuePair<string, string> kv in toImport)
            {
                ActiveValueSetEntries[kv.Key] = kv.Value;
            }
        }

        var notes = new List<string>();
        if (skipped > 0)
        {
            notes.Add($"{skipped} non-value entr{(skipped == 1 ? "y" : "ies")} skipped");
        }
        if (unmapped > 0)
        {
            notes.Add($"{unmapped} value(s) in unmapped namespaces skipped");
        }
        if (unknown > 0)
        {
            notes.Add($"{unknown} value(s) for nodes not in this nodeset skipped");
        }
        if (unchanged > 0)
        {
            notes.Add($"{unchanged} value(s) identical to the nodeset value not stored");
        }

        ValueSetStatus = $"Imported {toImport.Count} value(s) from '{fileName}' into '{ActiveValueSet.Name}'"
            + (notes.Count > 0 ? " (" + string.Join(", ", notes) + ")" : string.Empty) + ".";
        ValueSetStatusIsError = toImport.Count == 0 && (unmapped > 0 || unknown > 0);
        ValueSetImportDetails = skippedDetails;
        ShowValueSetImportDetails = toImport.Count == 0 && skippedDetails.Count > 0;

        await RefreshTreeAfterImportAsync(toImport.Keys).ConfigureAwait(false);
    }

    // Make the imported values visible immediately: expand the tree down to each imported node
    // (loading children on demand) and re-read the selected node so its value card is current.
    private async Task RefreshTreeAfterImportAsync(IEnumerable<string> importedNodeIds)
    {
        var expanded = new HashSet<NodesetViewerNode>(ExpandedNodes);
        int budget = 200;
        foreach (string nodeId in importedNodeIds)
        {
            if (budget-- <= 0)
            {
                break;
            }

            List<NodesetViewerNode> path = await FindPathToNodeAsync(TreeNodes, nodeId).ConfigureAwait(false);
            if (path == null)
            {
                continue;
            }

            // Expand every ancestor so the node (and its [value] marker) is actually on screen.
            for (int i = 0; i < path.Count - 1; i++)
            {
                expanded.Add(path[i]);
            }
        }

        ExpandedNodes = expanded.ToList();

        if (SelectedNode != null)
        {
            await SelectedNodeChanged(SelectedNode).ConfigureAwait(false);
        }

        await InvokeAsync(StateHasChanged).ConfigureAwait(false);
    }

    private async Task<List<NodesetViewerNode>> FindPathToNodeAsync(List<NodesetViewerNode> nodes, string nodeId)
    {
        if (nodes == null)
        {
            return null;
        }

        foreach (NodesetViewerNode node in nodes)
        {
            if (node == null)
            {
                continue;
            }

            if (string.Equals(node.Id, nodeId, StringComparison.Ordinal))
            {
                return new List<NodesetViewerNode> { node };
            }

            // Only descend into nodes whose children are already loaded; browsing the whole
            // address space here would be far too expensive for large nodesets.
            if (!node.ChildrenLoaded)
            {
                continue;
            }

            List<NodesetViewerNode> sub = await FindPathToNodeAsync(node.Children, nodeId).ConfigureAwait(false);
            if (sub != null)
            {
                sub.Insert(0, node);
                return sub;
            }
        }

        return null;
    }

    private async Task ResetSelectedNodeValue()
    {
        if (ActiveValueSet == null || SelectedNode == null)
        {
            return;
        }

        try
        {
            await ValueSetStore.RemoveValueAsync(ActiveValueSet.Id, _valueSetUserId, SelectedNode.Id).ConfigureAwait(false);
            ActiveValueSetEntries.Remove(SelectedNode.Id);
            NodeValue = await _client.VariableRead(UserName, NodesetIdentifier, SelectedNode.Id).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            ValueSetStatus = "Value could not be reset: " + ex.Message;
        }

        await InvokeAsync(StateHasChanged).ConfigureAwait(false);
    }

    // A copy creates a nodeset that may carry a DPP, so it is a DPP create and is audited like the
    // equivalent REST path in ApprovalController. This page had no auditing at all: copies made
    // through the browser UI left no trace in the audit log, while the same operation performed via
    // /approval was fully attributable.
    private async Task<string> CopyNodesetAuditedAsync()
    {
        // Attribute the entry to the authenticated user, not to the UserName parameter. UserName
        // arrives from the /browser query string, so it is caller-supplied and must never become the
        // operator id on a non-repudiable record. The controller's own Download/Save actions already
        // use User.Identity.Name for exactly this reason.
        var state = await AuthStateProvider.GetAuthenticationStateAsync().ConfigureAwait(false);
        string operatorId = state?.User?.Identity?.Name ?? "anonymous";

        // Write the intent first: the copy touches the blob store and the database, which share no
        // transaction, so an "Attempted" entry with no matching outcome is the signal that a copy may
        // have landed without being fully logged.
        string operationId = DppAuditOperationId.New();
        string elementPath = $"copy as {ModalValue}";

        try
        {
            await _auditLog.RecordAsync(operatorId, DppAuditOperation.Create, NodesetIdentifier, elementPath, "Attempted", operationId).ConfigureAwait(false);
        }
        catch (DppAuditException)
        {
            // Nothing has been written yet, so refusing here is the safe outcome: it is better to
            // decline a copy than to perform one that cannot be logged.
            return "Copy refused: the operation could not be recorded in the audit log.";
        }

        UploadResult result = await _client.CopyNodeset(UserName, NodesetIdentifier, ModalValue).ConfigureAwait(false);

        try
        {
            // Branch on literal outcomes rather than computing one into a variable. The source guard
            // in DppAuditCommittedOutcomeTests matches the outcome literal inside the invocation, so
            // passing a variable here would place this call outside the invariant it is meant to be
            // held to - it would read as compliant while being unchecked.
            if (result.Succeeded)
            {
                // The copy is durable, so a failure to record this outcome must not be reported as a
                // retryable refusal.
                await _auditLog.RecordCommittedOutcomeAsync(operatorId, DppAuditOperation.Create, NodesetIdentifier, elementPath, "Success", operationId).ConfigureAwait(false);
            }
            else if (result.PartiallyApplied)
            {
                // The nodeset was stored but the copy did not complete, so durable changes were left
                // behind and this must not be presented as a clean failure.
                await _auditLog.RecordCommittedOutcomeAsync(operatorId, DppAuditOperation.Create, NodesetIdentifier, elementPath, "PartialFailure", operationId).ConfigureAwait(false);
            }
            else
            {
                // Nothing was written, so a failed append here is a genuine, retryable refusal.
                await _auditLog.RecordAsync(operatorId, DppAuditOperation.Create, NodesetIdentifier, elementPath, "Failed", operationId).ConfigureAwait(false);
            }
        }
        catch (DppAuditException ex)
        {
            // There is no DppAuditFailureFilter on a Blazor render path, so the shaping a controller
            // would get from the filter has to happen here or the user sees an unhandled error while
            // the copy itself may have succeeded.
            return ex.MutationCommitted
                ? "Copy completed, but the audit entry could not be written. Do not retry; report this to an administrator."
                : "Copy failed and the outcome could not be recorded in the audit log.";
        }

        return result.Message;
    }

    protected override async Task OnInitializedAsync()
    {
        // Resolve the signed-in user before the first render so the value set controls are not
        // shown as 'sign in required' while the root is still being expanded.
        await ResolveValueSetUserAsync().ConfigureAwait(false);

        TreeNodes.Clear();

        NodesetViewerNode root = new NodesetViewerNode()
        {
            Id = ObjectIds.RootFolder.ToString(),
            Text = "Root",
            Children = new List<NodesetViewerNode>()
        };

        TreeNodes.Add(root);
        SelectedNode = root;

        try
        {
            await OnNodeExpand(root).ConfigureAwait(false);
        }
        finally
        {
            _initialLoad.TrySetResult();
        }

        if (!string.IsNullOrWhiteSpace(Search))
        {
            SearchQuery = Search;
            await SearchTree().ConfigureAwait(false);
        }
    }

    private async Task OnNodeExpand(NodesetViewerNode node)
    {
        await LoadChildrenAsync(node).ConfigureAwait(false);
    }

    private async Task LoadChildrenAsync(NodesetViewerNode node)
    {
        if (node == null || node.ChildrenLoaded)
        {
            return;
        }

        List<NodesetViewerNode> children = null;
        bool browseSucceeded = true;
        try
        {
            children = await _client.GetChildren(UserName, NodesetIdentifier, node.Id, true).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            browseSucceeded = false;
            Console.WriteLine($"OnNodeExpand failed for node '{node.Id}': {ex}");
        }

        // Filter out any null entries and drop nulls in place so downstream
        // Contains/GetHashCode/CompareTo can't NRE.
        var safeChildren = new List<NodesetViewerNode>();
        if (children != null)
        {
            foreach (var c in children)
            {
                if (c != null)
                {
                    c.Id ??= string.Empty;
                    c.Text ??= string.Empty;
                    safeChildren.Add(c);
                }
            }
        }

        safeChildren.Sort();
        node.Children = safeChildren;

        // Only cache the result when the browse itself did not throw, so that a
        // transient failure can be retried on the next expand/search.
        node.ChildrenLoaded = browseSucceeded;
    }

    private async Task LoadChildrenBatchAsync(List<NodesetViewerNode> nodes, CancellationToken ct)
    {
        var pending = nodes.Where(n => n != null && !n.ChildrenLoaded).ToList();
        if (pending.Count == 0)
        {
            return;
        }

        using var throttle = new SemaphoreSlim(SearchMaxConcurrentBrowses, SearchMaxConcurrentBrowses);
        var tasks = new List<Task>(pending.Count);
        foreach (var node in pending)
        {
            ct.ThrowIfCancellationRequested();
            await throttle.WaitAsync(ct).ConfigureAwait(false);
            tasks.Add(Task.Run(async () =>
            {
                try
                {
                    await LoadChildrenAsync(node).ConfigureAwait(false);
                }
                finally
                {
                    throttle.Release();
                }
            }, ct));
        }

        await Task.WhenAll(tasks).ConfigureAwait(false);
    }

    private string SelectedNodeDocumentationUrl;

    private List<EnumFieldInfo> SelectedNodeEnumFields;

    private async Task SelectedNodeChanged(NodesetViewerNode node)
    {
        SelectedNode = node;
        SelectedNodeDocumentationUrl = null;
        SelectedNodeEnumFields = null;
        WriteStatus = string.Empty;

        NodeValue = await _client.VariableRead(UserName, NodesetIdentifier, node.Id).ConfigureAwait(false);

        if (ActiveValueSet != null && ActiveValueSetEntries.TryGetValue(node.Id, out string overlayValue) && ReferenceEquals(SelectedNode, node))
        {
            NodeValue = overlayValue;
        }

        string blocker = await _client.GetVariableWriteBlocker(UserName, NodesetIdentifier, node.Id).ConfigureAwait(false);
        if (ReferenceEquals(SelectedNode, node))
        {
            EditBlockedReason = blocker;
        }

        if (string.Equals(node.NodeClass, "DataType", StringComparison.Ordinal))
        {
            var fields = await _client.ReadEnumFields(UserName, NodesetIdentifier, node.Id).ConfigureAwait(false);
            if (ReferenceEquals(SelectedNode, node))
            {
                SelectedNodeEnumFields = fields;
            }
        }

        try
        {
            var url = await DataProvider.GetNodeDocumentationUrlAsync(UserName, node.Id).ConfigureAwait(false);
            if (ReferenceEquals(SelectedNode, node))
            {
                SelectedNodeDocumentationUrl = url;
            }
        }
        catch (Exception)
        {
            SelectedNodeDocumentationUrl = null;
        }

        await PersistTreeStateAsync().ConfigureAwait(false);
    }

    private bool HasChildNodes(NodesetViewerNode node)
    {
        if (node.Children == null)
        {
            return false;
        }

        // Unknown until browsed; once loaded, an empty list is a real leaf.
        if (!node.ChildrenLoaded)
        {
            return true;
        }

        return IsVariablesOnlyFilterActive ? node.Children.Any(MayContainVariables) : node.Children.Count > 0;
    }

    private IEnumerable<NodesetViewerNode> VisibleChildren(NodesetViewerNode node)
    {
        if (node?.Children == null)
        {
            return Enumerable.Empty<NodesetViewerNode>();
        }

        return IsVariablesOnlyFilterActive ? node.Children.Where(MayContainVariables) : node.Children;
    }

    // A branch is shown only if its subtree contains a Variable that belongs to the selected
    // nodeset scope; branches with no in-scope nodes, or with in-scope nodes but no Variables, are
    // hidden. Children are browsed lazily, so enabling the filter triggers a scan that loads the
    // whole tree up front (see StartVariablesOnlyScan); while that scan runs, unbrowsed branches
    // stay visible so the tree does not flicker, and afterwards every branch has been resolved.
    private bool MayContainVariables(NodesetViewerNode node)
    {
        if (node == null)
        {
            return false;
        }

        if (string.Equals(node.NodeClass, "Variable", StringComparison.Ordinal) && IsNodeInScope(node, SearchScope))
        {
            return true;
        }

        if (!node.ChildrenLoaded)
        {
            return IsScanningVariables;
        }

        return node.Children != null && node.Children.Any(MayContainVariables);
    }

    private void StartVariablesOnlyScan()
    {
        _scanCts?.Cancel();
        _scanCts?.Dispose();
        _scanCts = null;

        if (!IsVariablesOnlyFilterActive || !_isInteractive)
        {
            IsScanningVariables = false;
            return;
        }

        _scanCts = new CancellationTokenSource();
        _ = ScanForVariablesAsync(_scanCts.Token);
    }

    private async Task ScanForVariablesAsync(CancellationToken ct)
    {
        IsScanningVariables = true;
        await InvokeAsync(StateHasChanged).ConfigureAwait(false);

        try
        {
            int visited = 0;
            var frontier = new List<NodesetViewerNode>(TreeNodes);
            while (frontier.Count > 0 && visited < SearchMaxNodes)
            {
                ct.ThrowIfCancellationRequested();

                await LoadChildrenBatchAsync(frontier, ct).ConfigureAwait(false);
                visited += frontier.Count;

                var next = new List<NodesetViewerNode>();
                foreach (var node in frontier)
                {
                    if (node.Children == null)
                    {
                        continue;
                    }

                    foreach (var child in node.Children)
                    {
                        // Variables are leaves for this purpose; nothing below them needs browsing.
                        if (!string.Equals(child.NodeClass, "Variable", StringComparison.Ordinal) && !child.ChildrenLoaded)
                        {
                            next.Add(child);
                        }
                    }
                }

                frontier = next;
                await InvokeAsync(StateHasChanged).ConfigureAwait(false);
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Variables-only scan failed: {ex.Message}");
        }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                IsScanningVariables = false;
                await InvokeAsync(StateHasChanged).ConfigureAwait(false);
            }
        }
    }

    private static string ExtractNodeIdSuffix(string nodeId)
    {
        if (string.IsNullOrEmpty(nodeId))
        {
            return string.Empty;
        }

        // NodeIds look like "nsu=...;i=2258", "ns=1;s=Foo", "i=2258", etc.
        // The identifier is always the segment after the last '='.
        var idx = nodeId.LastIndexOf('=');
        return (idx >= 0 && idx < nodeId.Length - 1)
            ? nodeId.Substring(idx + 1).Trim()
            : nodeId.Trim();
    }

    private static bool IsNodeInScope(NodesetViewerNode node, string scope)
    {
        if (string.IsNullOrEmpty(scope))
        {
            return true;
        }

        var id = node?.Id;
        if (string.IsNullOrEmpty(id))
        {
            return false;
        }

        // NodeIds from loaded nodesets are formatted as "nsu=<namespaceUri>;...".
        const string prefix = "nsu=";
        if (!id.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var end = id.IndexOf(';', prefix.Length);
        var nsu = end < 0 ? id.Substring(prefix.Length) : id.Substring(prefix.Length, end - prefix.Length);
        return nsu.StartsWith(scope, StringComparison.OrdinalIgnoreCase);
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchTree();
        }
    }

    private void ClearSearch()
    {
        SearchQuery = string.Empty;
        SearchStatus = string.Empty;
        SearchMatchIds.Clear();
        SearchMatches.Clear();
        SearchMatchAncestors.Clear();
        SearchExcludeIds.Clear();
        SearchCursor = -1;
    }

    private HashSet<string> SearchExcludeIds { get; set; } = new HashSet<string>(StringComparer.Ordinal);

    private async Task FindNext()
    {
        // If we already collected all matches (Find all mode), cycle the cursor.
        if (SearchMatches.Count > 1)
        {
            SearchCursor = (SearchCursor + 1) % SearchMatches.Count;
            var next = SearchMatches[SearchCursor];
            var nextAncestors = SearchMatchAncestors[SearchCursor];
            foreach (var a in nextAncestors)
            {
                if (!ExpandedNodes.Contains(a))
                {
                    ExpandedNodes.Add(a);
                }
            }
            await SelectedNodeChanged(next).ConfigureAwait(false);
            SearchStatus = $"Match {SearchCursor + 1} of {SearchMatches.Count} ({next.Text})";
            return;
        }

        // Otherwise re-run a single-hit search but skip already-shown matches.
        if (SelectedNode != null && !string.IsNullOrEmpty(SelectedNode.Id))
        {
            SearchExcludeIds.Add(SelectedNode.Id);
        }
        await SearchTree(preserveExcludes: true).ConfigureAwait(false);
    }

    private async Task SearchTree()
    {
        await SearchTree(preserveExcludes: false).ConfigureAwait(false);
    }

    private async Task SearchTree(bool preserveExcludes)
    {
        var term = SearchQuery?.Trim();
        if (string.IsNullOrEmpty(term) || TreeNodes.Count == 0)
        {
            return;
        }

        bool searchById = false;
        bool searchByType = false;
        bool searchByName = false;
        if (term.StartsWith("id:", StringComparison.OrdinalIgnoreCase))
        {
            searchById = true;
            term = term.Substring(3).Trim();
        }
        else if (term.StartsWith("type:", StringComparison.OrdinalIgnoreCase))
        {
            searchByType = true;
            term = term.Substring(5).Trim();
        }
        else if (term.StartsWith("name:", StringComparison.OrdinalIgnoreCase))
        {
            searchByName = true;
            term = term.Substring(5).Trim();
        }

        if (string.IsNullOrEmpty(term))
        {
            return;
        }

        // Cancel any traversal still running from a previous search.
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var ct = _searchCts.Token;

        IsSearching = true;
        SearchStatus = "Searching...";

        // Clear previous selection
        // does not persist while (or after) a new search runs.
        SelectedNode = new NodesetViewerNode();
        NodeValue = string.Empty;
        SearchMatchIds.Clear();
        SearchMatches.Clear();
        SearchMatchAncestors.Clear();
        SearchCursor = -1;
        if (!preserveExcludes)
        {
            SearchExcludeIds.Clear();
        }

        await InvokeAsync(StateHasChanged).ConfigureAwait(false);

        try
        {
            // Culture-aware, case-insensitive substring match.
            // Also ignores accent differences (e.g. "u" matches "ü") so users can
            // freely type any fragment of a node name (e.g. "pera" -> "Temperature").
            var compareInfo = System.Globalization.CultureInfo.CurrentCulture.CompareInfo;
            const System.Globalization.CompareOptions compareOptions =
                System.Globalization.CompareOptions.IgnoreCase |
                System.Globalization.CompareOptions.IgnoreNonSpace |
                System.Globalization.CompareOptions.IgnoreSymbols;

            // Breadth-first traversal so shallow matches are found first and no
            // single subtree can starve the search budget. We use a LinkedList
            // as a deque so that "Types"-related branches can be prioritized
            // (prepended) over the typically massive "Objects" subtree.
            var queue = new LinkedList<(NodesetViewerNode Node, List<NodesetViewerNode> Ancestors)>();
            foreach (var root in TreeNodes)
            {
                queue.AddLast((root, new List<NodesetViewerNode>()));
            }

            NodesetViewerNode match = null;
            List<NodesetViewerNode> matchAncestors = null;
            int visited = 0;
            var visitedNodeIds = new HashSet<string>(StringComparer.Ordinal);

            bool stop = false;

            while (!stop && queue.Count > 0 && visited < SearchMaxNodes)
            {
                ct.ThrowIfCancellationRequested();

                // Dequeue a batch so that the browses for all its nodes can be
                // issued concurrently instead of one awaited call per node.
                var batch = new List<(NodesetViewerNode Node, List<NodesetViewerNode> Ancestors)>(SearchBatchSize);
                while (batch.Count < SearchBatchSize && queue.Count > 0 && visited < SearchMaxNodes)
                {
                    batch.Add(queue.First.Value);
                    queue.RemoveFirst();
                    visited++;
                }

                var toExpand = new List<(NodesetViewerNode Node, List<NodesetViewerNode> Ancestors)>(batch.Count);

                foreach (var (current, ancestors) in batch)
                {
                    bool inScope = IsNodeInScope(current, SearchScope);
                    bool isMatch = false;

                    if (inScope && !string.IsNullOrEmpty(current.Id) && SearchExcludeIds.Contains(current.Id))
                    {
                        inScope = false;
                    }

                    if (inScope && searchById)
                    {
                        // Only compare the numeric/identifier part at the very end of the NodeId,
                        // e.g. "nsu=http://.../;i=2258" -> "2258", "ns=1;s=Foo" -> "Foo".
                        var currentIdSuffix = ExtractNodeIdSuffix(current.Id);
                        if (!string.IsNullOrEmpty(currentIdSuffix)
                            && string.Equals(currentIdSuffix, term, StringComparison.OrdinalIgnoreCase))
                        {
                            isMatch = true;
                        }
                    }
                    else if (inScope && searchByType)
                    {
                        if (!string.IsNullOrEmpty(current.BrowseName)
                            && compareInfo.IndexOf(current.BrowseName, term, compareOptions) >= 0)
                        {
                            isMatch = true;
                        }
                    }
                    else if (inScope && searchByName)
                    {
                        if (!string.IsNullOrEmpty(current.Text)
                            && compareInfo.IndexOf(current.Text, term, compareOptions) >= 0)
                        {
                            isMatch = true;
                        }
                    }
                    else if (inScope)
                    {
                        // No prefix: match BrowseName OR Display Name (case-insensitive substring).
                        if ((!string.IsNullOrEmpty(current.Text)
                                && compareInfo.IndexOf(current.Text, term, compareOptions) >= 0)
                            || (!string.IsNullOrEmpty(current.BrowseName)
                                && compareInfo.IndexOf(current.BrowseName, term, compareOptions) >= 0))
                        {
                            isMatch = true;
                        }
                    }

                    if (isMatch)
                    {
                        if (!string.IsNullOrEmpty(current.Id))
                        {
                            SearchMatchIds.Add(current.Id);
                        }

                        SearchMatches.Add(current);
                        SearchMatchAncestors.Add(ancestors);

                        if (match == null)
                        {
                            match = current;
                            matchAncestors = ancestors;
                        }

                        if (!FindAll)
                        {
                            stop = true;
                            break;
                        }
                    }

                    toExpand.Add((current, ancestors));
                }

                if (stop)
                {
                    break;
                }

                // Browse all not-yet-loaded nodes of this batch concurrently. Nodes
                // already browsed (including leaves) are served from the cache.
                await LoadChildrenBatchAsync(toExpand.Select(t => t.Node).ToList(), ct).ConfigureAwait(false);

                // Enqueue children in reverse batch order so that AddFirst keeps the
                // original relative ordering of prioritized "Types" branches.
                for (int i = toExpand.Count - 1; i >= 0; i--)
                {
                    var (current, ancestors) = toExpand[i];
                    if (current.Children == null || current.Children.Count == 0)
                    {
                        continue;
                    }

                    var childAncestors = new List<NodesetViewerNode>(ancestors) { current };
                    var typesChildren = new List<NodesetViewerNode>();
                    foreach (var child in current.Children)
                    {
                        // Prioritize the Types subtree (and everything inside it) so
                        // matches inside object/variable/data types are reached before
                        // the traversal budget is exhausted by the Objects subtree.
                        bool isTypesBranch =
                            (child.Text != null && child.Text.EndsWith("Types", StringComparison.OrdinalIgnoreCase))
                            || (child.BrowseName != null && child.BrowseName.EndsWith("Types", StringComparison.OrdinalIgnoreCase));

                        if (isTypesBranch)
                        {
                            typesChildren.Add(child);
                        }
                        else
                        {
                            queue.AddLast((child, childAncestors));
                        }
                    }

                    for (int j = typesChildren.Count - 1; j >= 0; j--)
                    {
                        queue.AddFirst((typesChildren[j], childAncestors));
                    }
                }
            }

            if (match != null)
            {
                foreach (var ancestor in matchAncestors)
                {
                    if (!ExpandedNodes.Contains(ancestor))
                    {
                        ExpandedNodes.Add(ancestor);
                    }
                }

                await SelectedNodeChanged(match).ConfigureAwait(false);
                SearchCursor = 0;
                SearchStatus = SearchMatches.Count > 1
                    ? $"Match 1 of {SearchMatches.Count} (first: {match.Text})"
                    : $"Found: {match.Text}";
            }
            else
            {
                SearchStatus = visited >= SearchMaxNodes
                    ? $"No match in first {SearchMaxNodes} nodes. Try a more specific term."
                    : $"No node matching '{term}' found.";
            }
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer search or the page was disposed; nothing to report.
            return;
        }
        catch (Exception ex)
        {
            SearchStatus = $"Search failed: {ex.Message}";
        }
        finally
        {
            if (!ct.IsCancellationRequested)
            {
                IsSearching = false;
                await InvokeAsync(StateHasChanged).ConfigureAwait(false);
            }
        }
    }

    public void Dispose()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = null;
        _scanCts?.Cancel();
        _scanCts?.Dispose();
        _scanCts = null;
    }

    private async Task DownloadAllDependencyNodesets()
    {
        try
        {
            IsDownloading = true;
            await InvokeAsync(StateHasChanged);

            // Get all loaded nodeset files
            var nodesetFiles = await _client.GetAllLoadedNodesetFilesAsync(UserName);

            if (nodesetFiles == null || nodesetFiles.Count == 0)
            {
                Console.WriteLine("No nodesets found to download.");
                return;
            }

            // Create a zip file in memory
            using var memoryStream = new MemoryStream();
            using (var archive = new ZipArchive(memoryStream, ZipArchiveMode.Create, true))
            {
                foreach (var kvp in nodesetFiles)
                {
// Sanitize the filename (replace invalid characters)

var url = new Uri(kvp.Key);

var invalidChars = new[] { '<', '>', ':', '"', '/', '\\', '|', '?', '*', '\0' };

string sanitizedKey = string.Join("_", (url.Host + url.PathAndQuery).Split(invalidChars, StringSplitOptions.RemoveEmptyEntries));

string fileName = $"{sanitizedKey}.xml";


                    // Create an entry in the zip file
                    var zipEntry = archive.CreateEntry(fileName, CompressionLevel.Optimal);

                    // Write the nodeset XML to the zip entry
                    using var entryStream = zipEntry.Open();
                    using var streamWriter = new StreamWriter(entryStream);
                    await streamWriter.WriteAsync(kvp.Value.Blob);
                }
            }

            // Reset the stream position
            memoryStream.Position = 0;

            // Generate a filename with timestamp
            var timestamp = DateTime.UtcNow.ToString("yyyyMMdd_HHmmss");
            var zipFileName = $"Nodesets_{NodesetName}_{timestamp}.zip";

            // Stream the zip file directly to the browser
            using var streamReference = new DotNetStreamReference(memoryStream);
            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", zipFileName, streamReference);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error downloading nodesets: {ex.Message}");
        }
        finally
        {
            IsDownloading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Saving used to post a plain HTML form to BrowserController.Save, which redirected back to
    // /browser and tore down the circuit - losing the search scope, query and filter selections.
    // The same ownership check, controlledElements merge and write-ahead auditing are done here
    // in-circuit so the page keeps its state.
    private async Task SaveNodeValues()
    {
        if (IsSaving)
        {
            return;
        }

        IsSaving = true;
        StatusMessage = string.Empty;
        await InvokeAsync(StateHasChanged).ConfigureAwait(false);

        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync().ConfigureAwait(false);
            string operatorId = state?.User?.Identity?.Name;

            NodeSetModel nodeSet = string.IsNullOrEmpty(operatorId) ? null : DataProvider.GetNodeSets(operatorId, NodesetIdentifier).FirstOrDefault();
            if ((nodeSet == null) || (operatorId != nodeSet.Metadata.UserId))
            {
                await _auditLog.RecordAsync(operatorId ?? "anonymous", DppAuditOperation.Modify, NodesetIdentifier, null, "Denied").ConfigureAwait(false);
                StatusMessage = "You are not authorized to save changes to this nodeset.";
                return;
            }

            DbFiles nodesetXml = await Storage.DownloadFileAsync(NodesetIdentifier).ConfigureAwait(false);
            if (nodesetXml == null)
            {
                StatusMessage = "The nodeset's stored values could not be loaded, so the save was refused to avoid dropping its access policy.";
                return;
            }

            Dictionary<string, string> results = await _client.BrowseVariableNodesResursivelyAsync(operatorId, NodesetIdentifier, null).ConfigureAwait(false);
            nodesetXml.Values = DppControlledElements.Merge(JsonSerializer.Serialize(results, s_saveJsonOptions), nodesetXml.Values);

            string operationId = DppAuditOperationId.New();
            await _auditLog.RecordAsync(operatorId, DppAuditOperation.Modify, NodesetIdentifier, null, "Attempted", operationId).ConfigureAwait(false);

            string name = await Storage.UploadFileAsync(NodesetIdentifier, nodesetXml.Blob, nodesetXml.Values).ConfigureAwait(false);
            if (name == null)
            {
                await _auditLog.RecordAsync(operatorId, DppAuditOperation.Modify, NodesetIdentifier, null, "Failed", operationId).ConfigureAwait(false);
                StatusMessage = "Failed to save changes to this nodeset.";
            }
            else
            {
                await _auditLog.RecordCommittedOutcomeAsync(operatorId, DppAuditOperation.Modify, NodesetIdentifier, null, "Success", operationId).ConfigureAwait(false);
                StatusMessage = "Save operation successful";
            }
        }
        catch (DppAuditException ex)
        {
            StatusMessage = ex.MutationCommitted
                ? "Save completed, but the audit entry could not be written. Do not retry; report this to an administrator."
                : "Save refused: the operation could not be recorded in the audit log.";
        }
        catch (Exception ex)
        {
            StatusMessage = "Failed to save changes to this nodeset: " + ex.Message;
        }
        finally
        {
            IsSaving = false;
            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        }
    }

    private static readonly JsonSerializerOptions s_saveJsonOptions = new() { Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping };

    private string ViewNodeType(NodesetViewerNode item)
    {
        return (item == null)? string.Empty : item.Id;
    }

    private string ViewNodeInfo(NodesetViewerNode item)
    {
        return (item == null)? string.Empty : item.Text;
    }
