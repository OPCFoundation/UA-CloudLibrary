    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _isInteractive = true;

        // OnInitializedAsync is still expanding the root when the first render completes. Browsing
        // the same nodeset from two paths at once makes UAClient start a second embedded server for
        // it, which fails and tears down the working session - leaving an empty tree.
        await _initialLoad.Task.ConfigureAwait(false);

        await LoadValueSetsAsync().ConfigureAwait(false);
        await InvokeAsync(StateHasChanged).ConfigureAwait(false);
        await RestoreTreeStateAsync().ConfigureAwait(false);
