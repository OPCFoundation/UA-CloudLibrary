    private async Task OnExpandedNodesChanged(IList<NodesetViewerNode> expanded)
    {
        ExpandedNodes = expanded;
        await PersistTreeStateAsync().ConfigureAwait(false);
    }

    private async Task PersistTreeStateAsync()
    {
        if (!_isInteractive || _isRestoringState)
        {
            return;
        }

        try
        {
            TreeState state = new TreeState {
                Expanded = ExpandedNodes.Where(n => n != null && !string.IsNullOrEmpty(n.Id)).Select(n => n.Id).Distinct(StringComparer.Ordinal).ToList(),
                Selected = SelectedNode?.Id
            };

            await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", TreeStateStorageKey, JsonSerializer.Serialize(state)).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Persisting tree state failed: {ex.Message}");
        }
    }

    private async Task RestoreTreeStateAsync()
    {
        TreeState state;
        try
        {
            string json = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", TreeStateStorageKey).ConfigureAwait(false);
            if (string.IsNullOrEmpty(json))
            {
                return;
            }

            state = JsonSerializer.Deserialize<TreeState>(json);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Reading tree state failed: {ex.Message}");
            return;
        }

        if (state == null)
        {
            return;
        }

        _isRestoringState = true;
        try
        {
            // Expanded ids may be stored in any order; re-expand in passes so that a child branch is
            // found once its parent has been loaded, until no further progress is made.
            HashSet<string> remaining = new HashSet<string>(state.Expanded ?? new List<string>(), StringComparer.Ordinal);
            bool progress = true;
            while (remaining.Count > 0 && progress)
            {
                progress = false;
                foreach (NodesetViewerNode node in EnumerateLoadedNodes())
                {
                    if (!remaining.Contains(node.Id))
                    {
                        continue;
                    }

                    await LoadChildrenAsync(node).ConfigureAwait(false);
                    if (!ExpandedNodes.Contains(node))
                    {
                        ExpandedNodes.Add(node);
                    }

                    remaining.Remove(node.Id);
                    progress = true;
                }
            }

            if (!string.IsNullOrEmpty(state.Selected))
            {
                NodesetViewerNode selected = EnumerateLoadedNodes().FirstOrDefault(n => string.Equals(n.Id, state.Selected, StringComparison.Ordinal));
                if (selected != null)
                {
                    await SelectedNodeChanged(selected).ConfigureAwait(false);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Restoring tree state failed: {ex.Message}");
        }
        finally
        {
            _isRestoringState = false;
        }

        await InvokeAsync(StateHasChanged).ConfigureAwait(false);
    }

    private IEnumerable<NodesetViewerNode> EnumerateLoadedNodes()
    {
        List<NodesetViewerNode> result = new List<NodesetViewerNode>();
        Queue<NodesetViewerNode> queue = new Queue<NodesetViewerNode>(TreeNodes);
        while (queue.Count > 0)
        {
            NodesetViewerNode node = queue.Dequeue();
            if (node == null || string.IsNullOrEmpty(node.Id))
            {
                continue;
            }

            result.Add(node);

            if (node.ChildrenLoaded && node.Children != null)
            {
                foreach (NodesetViewerNode child in node.Children)
                {
                    queue.Enqueue(child);
                }
            }
        }

        return result;
    }

