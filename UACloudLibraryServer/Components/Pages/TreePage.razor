
@using System.Net
@using System.Net.Http
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@using System.Web
@using System.IO
@using System.IO.Compression
@using System.Threading
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web;
@using Microsoft.AspNetCore.Http
@using Microsoft.JSInterop
@using AdminShell
@using Opc.Ua
@using Opc.Ua.Cloud.Library.Models
@using Opc.Ua.Cloud.Library.ValueSets

@inject UAClient _client
@inject CloudLibDataProvider DataProvider
@inject IJSRuntime JSRuntime
@inject IDppAuditLog _auditLog
@inject IValueSetStore ValueSetStore
@inject AuthenticationStateProvider AuthStateProvider
@inject DbFileStorage Storage
@implements IDisposable

<div class="d-flex align-items-center justify-content-between">
    <h1 class="mb-0">@NodesetName</h1>
    <span class="d-flex align-items-center">
        @if (!string.IsNullOrEmpty(CopyStatus))
        {
            <span class="text-muted mr-3">@CopyStatus</span>
        }
        <button type="button" class="btn btn-primary" title="Copy nodeset file" @onclick="() => OpenCopyDialog()"><i class="fas fa-copy mr-2"></i>Copy</button>
    </span>
</div>
<div style="height:100%">
    <div class="uacl-container">
        <div class="uacl-content">
            <div class="container">
                <p>
                    <div class="col-12 row">
                        <div class="col-12">
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="@(() => ShowNodesetDetails = !ShowNodesetDetails)" aria-expanded="@ShowNodesetDetails.ToString().ToLowerInvariant()">
                                <i class="fas @(ShowNodesetDetails ? "fa-chevron-up" : "fa-chevron-down") mr-2"></i>@(ShowNodesetDetails ? "Hide nodeset details" : "Show nodeset details")
                            </button>
                        </div>
                    </div>
                </p>
                @if (ShowNodesetDetails)
                {
                    <p>
                        <div class="col-12 row">
                            <div class="col-6">
                                <div class="card h-100">
                                    <div class="card-header">
                                        <b>Loaded Nodesets</b>
                                        <button type="button" class="btn btn-primary btn-sm" style="float: right" @onclick="DownloadAllDependencyNodesets" disabled="@IsDownloading">
                                            @if (IsDownloading)
                                            {
                                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                                <span> Preparing...</span>
                                            }
                                            else
                                            {
                                                <span>Download All</span>
                                            }
                                        </button>
                                        <br/>
                                    </div>
                                    <div class="card-body">
                                        @foreach (KeyValuePair<string, Tuple<string, string>> ns in _client.LoadedNamespaces)
                                        {
                                            <span>@ns.Key ReqVer: @ns.Value.Item1 LoadVer: @ns.Value.Item2</span><br/>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="card h-100">
                                    <div class="card-header">
                                        <b>Required Nodesets Missing from UA Cloud Library</b><br/>
                                    </div>
                                    <div class="card-body">
                                        @if (_client.MissingNamespaces.Count == 0)
                                        {
                                            <span>(none)</span><br/>
                                        }
                                        else
                                        {
                                            foreach (var ns in _client.MissingNamespaces)
                                            {
                                                <span>@ns</span><br/>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </p>
                }
                <p>
                    <div class="col-12 row">
                        <div class="col-6">
                            <div class="card h-100">
                                <div class="card-header">
                                    <b>Nodeset Browser</b>
                                    <div class="input-group input-group-sm mt-2">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">Nodeset scope</span>
                                        </div>
                                        <select class="form-control" @bind="SearchScope" disabled="@IsSearching">
                                            <option value="">All</option>
                                            @if (_client?.LoadedNamespaces != null)
                                            {
                                                @foreach (var ns in _client.LoadedNamespaces.Keys.OrderBy(k => k, StringComparer.OrdinalIgnoreCase))
                                                {
                                                    <option value="@ns">@ns</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div class="input-group input-group-sm mt-2">
                                        <div class="input-group-prepend">
                                            <button type="button" class="btn btn-outline-secondary" title="Search help" aria-label="Search help" @onclick="@(() => ShowSearchHelp = true)" disabled="@IsSearching">
                                                <strong>?</strong>
                                            </button>
                                        </div>
                                        <input type="text" class="form-control" placeholder="Search (name:, type:, id: or plain text)..."
                                               @bind="SearchQuery" @bind:event="oninput"
                                               @onkeydown="OnSearchKeyDown" disabled="@IsSearching" />
                                        <div class="input-group-append">
                                            @if (!string.IsNullOrEmpty(SearchQuery))
                                            {
                                                <button type="button" class="btn btn-outline-secondary" title="Clear" @onclick="ClearSearch" disabled="@IsSearching">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            }
                                            <button type="button" class="btn btn-primary" aria-label="Search tree" @onclick="SearchTree" disabled="@(IsSearching || string.IsNullOrWhiteSpace(SearchQuery))">

                                                @if (IsSearching)
                                                {
                                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-search"></i>
                                                }
                                            </button>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(SearchStatus))
                                    {
                                        <small class="text-muted d-block mt-1">@SearchStatus</small>
                                    }

                                    <div class="d-flex align-items-center mt-2">
                                        <div class="custom-control custom-checkbox mr-3">
                                            <input type="checkbox" class="custom-control-input" id="findAllCheckbox"
                                                   @bind="FindAll" disabled="@IsSearching" />
                                            <label class="custom-control-label" for="findAllCheckbox">Find all</label>
                                        </div>
                                        <div class="custom-control custom-checkbox mr-3">
                                            <input type="checkbox" class="custom-control-input" id="variablesOnlyCheckbox"
                                                   @bind="ShowVariablesOnly" disabled="@(IsSearching || string.IsNullOrEmpty(SearchScope))" />
                                            <label class="custom-control-label" for="variablesOnlyCheckbox" title="@(string.IsNullOrEmpty(SearchScope) ? "Select a nodeset scope to filter the tree" : "Only show branches of the selected nodeset scope that contain Variable nodes")">Show Variables Only</label>
                                            @if (IsScanningVariables)
                                            {
                                                <span class="spinner-border spinner-border-sm text-muted ml-2" role="status" title="Scanning the tree for Variables..." aria-hidden="true"></span>
                                            }
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                @onclick="FindNext"
                                                disabled="@(IsSearching || SearchMatchIds.Count == 0)">
                                            <i class="fas fa-arrow-down mr-1"></i>Find next
                                        </button>
                                    </div>

                                    @if (ShowSearchHelp)
                                    {
                                        <div class="modal-backdrop fade show" @onclick="@(() => ShowSearchHelp = false)"></div>
                                    }
                                    <div class="modal fade @(ShowSearchHelp ? "show" : string.Empty)" tabindex="-1" aria-labelledby="treeSearchHelpModalLabel" aria-hidden="@(ShowSearchHelp ? "false" : "true")" style="@(ShowSearchHelp ? "display: block;" : "display: none;")" role="dialog">
                                        <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="treeSearchHelpModalLabel">Search options</h5>
                                                    <button type="button" class="btn-close" aria-label="Close" @onclick="@(() => ShowSearchHelp = false)">&times;</button>
                                                </div>
                                                <div class="modal-body">
                                                    <p>
                                                        Enter a keyword to locate a node in the tree. Use a filter prefix to change
                                                        what the term is matched against.
                                                    </p>
                                                    <table class="table table-sm table-striped">
                                                        <thead>
                                                            <tr>
                                                                <th style="width: 130px;">Filter</th>
                                                                <th>Description</th>
                                                                <th style="width: 260px;">Example</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr>
                                                                <td><em>(no prefix)</em></td>
                                                                <td>Matches any part of the node's <em>BrowseName</em> or <em>DisplayName</em> (case-insensitive, accent-insensitive).</td>
                                                                <td><code>temperature</code></td>
                                                            </tr>
                                                            <tr>
                                                                <td><code>name:</code></td>
                                                                <td>Matches only the node's <em>DisplayName</em> (case-insensitive substring).</td>
                                                                <td><code>name:Temperature</code></td>
                                                            </tr>
                                                            <tr>
                                                                <td><code>type:</code></td>
                                                                <td>Matches only the node's <em>BrowseName</em> (case-insensitive substring).</td>
                                                                <td><code>type:MotorType</code></td>
                                                            </tr>
                                                            <tr>
                                                                <td><code>id:</code></td>
                                                                <td>Matches a node whose identifier (the value after the last <code>=</code> in the NodeId, e.g. <code>2258</code> from <code>nsu=...;i=2258</code>) is exactly the given value.</td>
                                                                <td><code>id:2258</code></td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                    <p class="mb-0">
                                                        <strong>Tip:</strong> The search expands ancestor branches and selects the first match it finds.
                                                    </p>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" @onclick="@(() => ShowSearchHelp = false)">Close</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <Tree Nodes="TreeNodes" TNode="NodesetViewerNode" ChildSelector="VisibleChildren" SelectedNodeChanged="SelectedNodeChanged" OnNodeExpand="OnNodeExpand" HasChildNodes="HasChildNodes" ExpandedNodes="ExpandedNodes" ExpandedNodesChanged="OnExpandedNodesChanged">
                                        <TitleTemplate>
                                            @{
                                                bool isSelected = context.Id == SelectedNode.Id;
                                                bool isMatch = SearchMatchIds != null && SearchMatchIds.Contains(context.Id);
                                                string color = isSelected ? "red" : (isMatch ? "#0d6efd" : null);
                                                bool bold = context.Id != null
                                                    && context.Id.StartsWith("nsu=")
                                                    && IsNodeInScope(context, SearchScope);
                                                string style = (color != null ? "color:" + color + ";" : string.Empty)
                                                    + (isMatch && !isSelected ? "background-color:#fff3cd;" : string.Empty);
                                                string setValue = null;
                                                bool hasSetValue = ActiveValueSet != null && context.Id != null && ActiveValueSetEntries.TryGetValue(context.Id, out setValue);
                                            }
                                            <span style="@style">
                                                @if (bold)
                                                {
                                                    <b>@context.Text</b>
                                                }
                                                else
                                                {
                                                    @context.Text
                                                }
                                            </span>
                                            @if (hasSetValue)
                                            {
                                                <span class="text-muted ml-1" title="Value in value set '@ActiveValueSet.Name'">[@setValue]</span>
                                            }
                                        </TitleTemplate>
                                    </Tree>
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="card mb-3">
                                <div class="card-header">
                                    <b><i class="fas fa-info-circle mr-2"></i>Selected Node Information</b>
                                </div>
                                <div class="card-body">
                                    @if (SelectedNode != null && !string.IsNullOrEmpty(SelectedNode.Id))
                                    {
                                        <dl class="row mb-0">
                                            <dt class="col-sm-4 text-truncate">Display Name</dt>
                                            <dd class="col-sm-8">@(string.IsNullOrEmpty(SelectedNode.Text) ? "(none)" : SelectedNode.Text)</dd>

                                            <dt class="col-sm-4 text-truncate">Browse Name</dt>
                                            <dd class="col-sm-8">@(string.IsNullOrEmpty(SelectedNode.BrowseName) ? "(none)" : SelectedNode.BrowseName)</dd>

                                            <dt class="col-sm-4 text-truncate">Node Class</dt>
                                            <dd class="col-sm-8">@(string.IsNullOrEmpty(SelectedNode.NodeClass) ? "(unknown)" : SelectedNode.NodeClass)</dd>

                                            <dt class="col-sm-4 text-truncate">Node Id</dt>
                                            <dd class="col-sm-8"><code style="word-break: break-all;">@SelectedNode.Id</code></dd>

                                            @if (!string.IsNullOrEmpty(SelectedNodeDocumentationUrl))
                                            {
                                                <dt class="col-sm-4 text-truncate">Documentation</dt>
                                                <dd class="col-sm-8">
                                                    <a href="@SelectedNodeDocumentationUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary" title="Open the reference documentation for this type">
                                                        <i class="fas fa-external-link-alt mr-2"></i>Reference: @SelectedNode.BrowseName
                                                    </a>
                                                </dd>
                                            }

                                            <dt class="col-sm-4 text-truncate">Value</dt>
                                            <dd class="col-sm-8">
                                                @if (!string.IsNullOrEmpty(NodeValue))
                                                {
                                                    <span>@NodeValue</span>
                                                }
                                                else if (!string.IsNullOrEmpty(SelectedNode.Value))
                                                {
                                                    <span>@SelectedNode.Value</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">(none)</span>
                                                }
                                            </dd>

                                            <dt class="col-sm-4 text-truncate">Child Nodes</dt>
                                            <dd class="col-sm-8">
                                                @if (SelectedNode.ChildrenLoaded && SelectedNode.Children != null)
                                                {
                                                    <span>@SelectedNode.Children.Count</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">(not loaded)</span>
                                                }
                                            </dd>
                                        </dl>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Select a node in the tree to see its details.</span>
                                    }
                                </div>
                            </div>
                            @if (SelectedNodeEnumFields != null && SelectedNodeEnumFields.Count > 0)
                            {
                                <div class="card mb-3">
                                    <div class="card-header">
                                        <b><i class="fas fa-list-ol mr-2"></i>Enum Fields</b>
                                    </div>
                                    <div class="card-body p-0">
                                        <table class="table table-sm table-striped mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Value</th>
                                                    <th>Name</th>
                                                    <th>Description</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var field in SelectedNodeEnumFields)
                                                {
                                                    <tr>
                                                        <td><code>@field.Value</code></td>
                                                        <td>@field.Name</td>
                                                        <td class="text-muted">@field.Description</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }
                            <div class="card">
                                <div class="card-header">
                                    <b><span style="color: red;">Selected Node</span> Value</b>
                                    <span style="float: right">
                                        <button type="button" class="btn btn-primary" @onclick="() => OpenEditDialog(NodeValue)" disabled="@(!CanEditSelectedNode)" title="@(CanEditSelectedNode ? "Edit the value of the selected node" : EditBlockedReason)">Edit</button>
                                        <button id="saveButton" type="button" class="btn btn-primary btn_browser" style="margin-left: 0.5rem" @onclick="SaveNodeValues" disabled="@IsSaving" title="Save the current node values to the nodeset">
                                            @if (IsSaving)
                                            {
                                                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                                <span> Saving...</span>
                                            }
                                            else
                                            {
                                                <span>Save</span>
                                            }
                                        </button>
                                    </span><br/>
                                    @if (!CanEditSelectedNode && !string.IsNullOrEmpty(EditBlockedReason))
                                    {
                                        <span class="text-muted"><i class="fas fa-lock mr-1"></i>@EditBlockedReason</span><br/>
                                    }
                                    @if (!string.IsNullOrEmpty(WriteStatus))
                                    {
                                        <span style="color: red;">@WriteStatus</span>
                                    }
                                    @if (!string.IsNullOrEmpty(StatusMessage))
                                    {
                                        <span>@StatusMessage</span><br/>
                                    }
                                    <div class="input-group input-group-sm mt-2">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text" title="Node values are read from and edits are written to the selected value set. 'Nodeset values' are the owner's canonical values; your own value sets are private overlays on top of them.">Value set</span>
                                        </div>
                                        <select class="form-control" value="@ActiveValueSetId" @onchange="OnValueSetSelected" disabled="@(!CanUseValueSets)">
                                            <option value="">Nodeset values</option>
                                            @foreach (var set in ValueSets)
                                            {
                                                <option value="@set.Id">@set.Name</option>
                                            }
                                        </select>
                                        <div class="input-group-append">
                                            <div class="btn-group @(ShowValueSetMenu ? "show" : string.Empty)">
                                                <button type="button" class="btn btn-outline-secondary dropdown-toggle" title="Value set actions" aria-haspopup="true" aria-expanded="@ShowValueSetMenu.ToString().ToLowerInvariant()" @onclick="@(() => ShowValueSetMenu = !ShowValueSetMenu)" disabled="@(!CanUseValueSets || IsImporting)">
                                                    @if (IsImporting)
                                                    {
                                                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                                    }
                                                    else
                                                    {
                                                        <span>Actions</span>
                                                    }
                                                </button>
                                                <div class="dropdown-menu dropdown-menu-right @(ShowValueSetMenu ? "show" : string.Empty)">
                                                    <button type="button" class="dropdown-item" title="Create a new empty value set" @onclick="@(() => { ShowValueSetMenu = false; OpenNewValueSetDialog(); })">New</button>
                                                    <button type="button" class="dropdown-item" title="Rename the selected value set" @onclick="@(() => { ShowValueSetMenu = false; OpenRenameValueSetDialog(); })" disabled="@(ActiveValueSet == null)">Rename</button>
                                                    <button type="button" class="dropdown-item" title="Copy the selected value set" @onclick="@(() => { ShowValueSetMenu = false; OpenCloneValueSetDialog(); })" disabled="@(ActiveValueSet == null)">Clone</button>
                                                    <div class="dropdown-divider"></div>
                                                    @if (ActiveValueSet == null)
                                                    {
                                                        <button type="button" class="dropdown-item" disabled>Import...</button>
                                                        <button type="button" class="dropdown-item" disabled>Export</button>
                                                    }
                                                    else
                                                    {
                                                        <label class="dropdown-item mb-0" for="valueSetImportFile" style="cursor: pointer" title="Import node values from a previously exported JSON file into the selected value set" @onclick="@(() => ShowValueSetMenu = false)">Import...</label>
                                                        <a class="dropdown-item" title="Download the nodeset values with this set applied" href="@($"/valuesets/{ActiveValueSet.Id}/export")" target="_blank" @onclick="@(() => ShowValueSetMenu = false)">Export</a>
                                                    }
                                                    <div class="dropdown-divider"></div>
                                                    <button type="button" class="dropdown-item text-danger" title="Delete the selected value set" @onclick="@(() => { ShowValueSetMenu = false; return DeleteActiveValueSet(); })" disabled="@(ActiveValueSet == null)">Delete</button>
                                                </div>
                                            </div>
                                            <InputFile id="valueSetImportFile" accept=".json,application/json" style="display: none" OnChange="ImportValueSetFile" />
                                        </div>
                                    </div>
                                    @if (!CanUseValueSets)
                                    {
                                        <small class="text-muted">Sign in to create your own value sets for this nodeset.</small>
                                    }
                                    else if (!_valueSetsLoaded)
                                    {
                                        <small class="text-muted">Loading your value sets...</small>
                                    }
                                    else if (ActiveValueSet != null)
                                    {
                                        <small class="text-muted">@ActiveValueSetEntries.Count node value(s) overridden in this set. Edits are stored privately in the set and do not change the nodeset itself.</small>
                                    }
                                    @if (!string.IsNullOrEmpty(ValueSetStatus))
                                    {
                                        <br/><span style="color: @(ValueSetStatusIsError ? "red" : "green");">@ValueSetStatus</span>
                                        @if (ValueSetImportDetails.Count > 0)
                                        {
                                            <button type="button" class="btn btn-link btn-sm p-0 ml-2" @onclick="@(() => ShowValueSetImportDetails = !ShowValueSetImportDetails)">@(ShowValueSetImportDetails ? "Hide details" : "Show details")</button>
                                            @if (ShowValueSetImportDetails)
                                            {
                                                <ul class="small text-muted mt-1 mb-0 pl-3" style="max-height: 12rem; overflow-y: auto;">
                                                    @foreach (string detail in ValueSetImportDetails)
                                                    {
                                                        <li style="word-break: break-all;">@detail</li>
                                                    }
                                                </ul>
                                            }
                                        }
                                    }
                                </div>
                                <div class="card-body">
                                    @if (!string.IsNullOrEmpty(NodeValue))
                                    {
                                        <span>@NodeValue</span>
                                    }
                                    else
                                    {
                                        <span>(none)</span>
                                    }
                                    @if (ActiveValueSet != null && SelectedNode != null)
                                    {
                                        @if (SelectedNodeIsOverridden)
                                        {
                                            <span class="badge badge-info ml-2" title="This value comes from the selected value set">@ActiveValueSet.Name</span>
                                            <button type="button" class="btn btn-link btn-sm" title="Remove this node from the value set and fall back to the nodeset value" @onclick="ResetSelectedNodeValue">Reset to nodeset value</button>
                                        }
                                        else
                                        {
                                            <span class="badge badge-light ml-2" title="This node is not overridden in the selected value set">nodeset value</span>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </p>
            </div>
        </div>
    </div>
</div>
<div class="modal @ModalClass" tabindex="-1" role="dialog" style="@ModalDisplay">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@ModalTitle</h5>
            </div>
            <div class="modal-body">
                @ModalDescription
            </div>
            <div class="modal-body">
                <input class="modal-input" @bind=@ModalValue />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal" @onclick="() => Close(true)">Save</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal" @onclick="() => Close(false)">Cancel</button>
            </div>
        </div>
    </div>
</div>

@if (ShowBackDrop)
{
    <div class="modal-backdrop fade show"></div>
}

@if (ShowNamespaceMapDialog)
{
    <div class="modal show" tabindex="-1" role="dialog" style="display:block;">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Map namespace indexes</h5>
                </div>
                <div class="modal-body">
                    <p>
                        The file '@_pendingImportFileName' refers to node ids by namespace index (<code>ns=…</code>) instead of namespace URI (<code>nsu=…</code>).
                        Namespace indexes are only valid within the server that exported the file, so please select which loaded nodeset each index refers to.
                    </p>
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th style="width: 8rem">Index</th>
                                <th>Nodeset (namespace URI)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (ushort index in PendingNamespaceIndexes)
                            {
                                ushort idx = index;
                                <tr>
                                    <td><code>ns=@idx</code></td>
                                    <td>
                                        <select class="form-control form-control-sm" value="@(NamespaceMappings.TryGetValue(idx, out string sel) ? sel : string.Empty)" @onchange="@(e => NamespaceMappings[idx] = e.Value?.ToString() ?? string.Empty)">
                                            <option value="">(skip values in this namespace)</option>
                                            @if (_client?.LoadedNamespaces != null)
                                            {
                                                @foreach (var ns in _client.LoadedNamespaces.Keys.OrderBy(k => k, StringComparer.OrdinalIgnoreCase))
                                                {
                                                    <option value="@ns">@ns</option>
                                                }
                                            }
                                        </select>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="ConfirmNamespaceMapping" disabled="@(IsImporting || !NamespaceMappings.Values.Any(v => !string.IsNullOrEmpty(v)))">Import</button>
                    <button type="button" class="btn btn-secondary" @onclick="CancelNamespaceMapping" disabled="@IsImporting">Cancel</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

